{
  "name": "medifollow-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:full": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "test:ai-providers": "tsx server/ai/test-providers.ts",
    "test:ai-resilience": "tsx server/ai/test-resilience.ts",
    "test:clinical-regression": "tsx server/ai/test-clinical-regression.ts",
    "test:all-offline": "npm run test:ai-resilience && npm run test:clinical-regression && npm run test:medical-dictionary && npm run test:medical-speech",
    "test:clinical-live": "tsx server/ai/test-clinical-live.ts",
    "test:complete": "npm run build && npm run test:all-offline",
    "test:medical-dictionary": "tsx scripts/test-medical-dictionary.ts",
    "test:medical-speech": "tsx scripts/test-medical-speech-regression.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
