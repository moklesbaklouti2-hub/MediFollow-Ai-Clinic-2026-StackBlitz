    "test:ai-providers": "tsx server/ai/test-providers.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
