# MediFollow AI — variables serveur uniquement
# Copiez ce fichier vers .env et renseignez vos propres clés.
# Ne publiez jamais le fichier .env dans GitHub.

GROQ_API_KEY=

# Cloudflare Workers AI (premier secours)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter (deuxième secours)
OPENROUTER_API_KEY=
# Modèle gratuit dynamique ; peut être remplacé par un identifiant exact du catalogue.
OPENROUTER_MODEL=openrouter/free
